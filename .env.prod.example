
POSTGRES_USER=teacherapp_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_20_CHARS_MIN
POSTGRES_DB=student_management

# SECRET_KEY: Use para assinar tokens JWT
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_64_BYTES

ACCESS_TOKEN_EXPIRE_MINUTES=120

ALGORITHM=HS256

CORS_ORIGINS=https://myteacherapp.com.br,https://www.myteacherapp.com.br

# Usada nos retornos do Stripe Checkout. Sem ela o retorno aponta para o host interno do container.
FRONTEND_URL=https://myteacherapp.com.br

# Stripe modo live. Env vence o que estiver salvo em Configurações (ver _cfg em routers/billing.py).
# Use uma restricted key (rk_live_), nunca a sk_live_ raiz. Segredos NÃO entram neste arquivo.
STRIPE_SECRET_KEY=CHANGE_ME_RK_LIVE
# Endpoint we_1U3KumFMrE6KyqsPnX55EkFP -> https://myteacherapp.com.br/api/billing/webhook
STRIPE_WEBHOOK_SECRET=CHANGE_ME_WHSEC_DO_ENDPOINT_LIVE
# Prices live (BRL, mensal): R$ 47,90 e R$ 97,90
STRIPE_PRICE_ESSENCIAL=price_1U3KuJFMrE6KyqsP6ek01DuA
STRIPE_PRICE_PROFISSIONAL=price_1U3KugFMrE6KyqsPjyUNvpDH
STRIPE_PRICE_ID=price_1U3KugFMrE6KyqsPjyUNvpDH

VITE_SUPPORT_WHATSAPP_NUMBER=5521994152560

PORT_FRONTEND=80

PGADMIN_EMAIL=admin@myteacherapp.com.br
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

TAG=latest