# Ativa as checagens de boot (SECRET_KEY forte, FRONTEND_URL, CORS) e desliga /docs
ENVIRONMENT=production

POSTGRES_USER=teacherapp_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_20_CHARS_MIN
POSTGRES_DB=student_management

# SECRET_KEY: Use para assinar tokens JWT
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_64_BYTES

ACCESS_TOKEN_EXPIRE_MINUTES=120

ALGORITHM=HS256

CORS_ORIGINS=https://myteacherapp.com.br,https://www.myteacherapp.com.br

# Usada nos retornos do Stripe Checkout. Sem ela o retorno aponta para o host interno do container.
FRONTEND_URL=https://myteacherapp.com.br

# Stripe modo live. Env vence o que estiver salvo em Configurações (ver _cfg em routers/billing.py).
# Use uma restricted key (rk_live_), nunca a sk_live_ raiz. Segredos NÃO entram neste arquivo.
STRIPE_SECRET_KEY=CHANGE_ME_RK_LIVE
# Gere tudo abaixo com: STRIPE_SECRET_KEY=rk_live_... python scripts/stripe_setup.py
# (cria/adota produtos, prices, portal do cliente e o webhook /api/billing/webhook e imprime estas linhas)
STRIPE_WEBHOOK_SECRET=CHANGE_ME_WHSEC_DO_ENDPOINT_LIVE
# Prices live (BRL, mensal): R$ 47,90, R$ 97,90 e R$ 297,90 — ID do PREÇO (price_…), não do produto
STRIPE_PRICE_ESSENCIAL=CHANGE_ME_PRICE_LIVE
STRIPE_PRICE_PROFISSIONAL=CHANGE_ME_PRICE_LIVE
STRIPE_PRICE_ESCOLA=CHANGE_ME_PRICE_LIVE
STRIPE_PRICE_ID=CHANGE_ME_PRICE_LIVE

VITE_SUPPORT_WHATSAPP_NUMBER=5521994152560

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://myteacherapp.com.br/api/auth/google/callback
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# Endpoints do Google (opcional - defaults padrões já configurados)
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
# GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3/calendars/primary/events
# GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events

PORT_FRONTEND=80

PGADMIN_EMAIL=admin@myteacherapp.com.br
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

TAG=latest
# E-mail (SMTP) — confirmação de e-mail e recuperação de senha.
# Sem SMTP_HOST os e-mails só aparecem no log.
# Brevo: painel > SMTP & API > SMTP. O remetente do SMTP_FROM precisa estar verificado na Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP_USER = "Login" do SMTP (ex.: 9a1b2c001@smtp-brevo.com); SMTP_PASSWORD = chave SMTP (não é a API key v3)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyTeacherApp <nao-responda@myteacherapp.com.br>
