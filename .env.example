SECRET_KEY=your-secret-key-here-change-in-production-please-use-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

PORT_BACKEND=
PORT_FRONTEND=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Para produção com nginx proxy, use /api
# Para desenvolvimento local, use http://localhost:8500
VITE_API_URL=/api

# Stripe (sobrescreve o que estiver em Configurações do admin)
# Produção: chaves sk_live_ / whsec_ do endpoint live e prices criados no modo live.
# Este arquivo é versionado: nunca cole chaves aqui, só no .env (ignorado pelo git).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price de fallback, usado só em checkout sem plano selecionado
STRIPE_PRICE_ID=
# Prices por plano (sincronizados no boot em backend/core/init_db.py)
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
# URL pública do frontend, usada no retorno do Checkout. Obrigatória em produção:
# sem ela o retorno aponta para a URL interna do container.
FRONTEND_URL=https://seudominio.com.br
VITE_SUPPORT_WHATSAPP_NUMBER=5521994152560
